{
  "name": "tutorial-college-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --experimental-strip-types --test lib/*.test.ts && vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test tests/e2e",
    "test:responsive": "playwright test tests/responsive",
    "test:a11y": "playwright test tests/a11y",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:responsive && npm run test:a11y",
    "test:coverage": "vitest run --coverage",
    "create-owner": "node --experimental-strip-types scripts/create-owner.ts",
    "create-teacher": "node --experimental-strip-types scripts/create-test-teacher.ts"
  },
  "overrides": {
    "@react-pdf/hyphenate": "0.1.0",
    "jose": "^5.9.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "nodemailer": "^10.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.7",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
