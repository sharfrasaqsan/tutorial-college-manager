rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && request.auth.token.role == 'owner';
    }

    function isTeacher() {
      return isAuthenticated() && request.auth.token.role == 'teacher';
    }

    function isOwnTeacher(teacherId) {
      return isAuthenticated() && request.auth.uid == teacherId;
    }

    // 1. DEFAULT DENY ALL: deny by default for all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Institutional settings (college profile, academic, public site)
    // No public reads - public website reads strictly server-side using firebase-admin
    match /settings/{settingId} {
      allow read: if isOwner();
      allow write: if isOwner();
    }

    // 3. User records
    match /users/{userId} {
      allow read: if isOwner() || (isAuthenticated() && request.auth.uid == userId);
      // Teachers write only through the API
      allow write: if isOwner();
    }

    // 4. Permanent teacher profiles
    // No public reads - public site reads server-side
    match /teachers/{teacherId} {
      allow read: if isOwner() || isOwnTeacher(teacherId);
      // Teachers write only through the API
      allow write: if isOwner();
    }

    // 5. Permanent student records
    // Protected - owner only; teachers cannot read student records directly
    match /students/{studentId} {
      allow read, write: if isOwner();
    }

    // 6. Academic Years container
    match /years/{yearId} {
      allow read: if isOwner() || isTeacher();
      allow write: if isOwner();

      // Student academic roster per year
      match /roster/{studentId} {
        allow read, write: if isOwner();
      }

      // Classes within the year
      match /classes/{classId} {
        // A teacher can read ONLY own assigned classes; owner can read all
        allow read: if isOwner() || (isTeacher() && resource.data.teacherId == request.auth.uid);
        allow write: if isOwner();

        // Fee and pricing terms: owner only, teachers NEVER see fees
        match /terms/{termId} {
          allow read, write: if isOwner();
        }

        // Enrolled student roster for the class:
        // A teacher can read the roster of ONLY their own classes
        match /enrolments/{studentId} {
          allow read: if isOwner() || (
            isTeacher() && get(/databases/$(database)/documents/years/$(yearId)/classes/$(classId)).data.teacherId == request.auth.uid
          );
          allow write: if isOwner();
        }
      }

      // Timetable Slots (recurring weekly times)
      match /slots/{slotId} {
        allow read: if isOwner() || (isTeacher() && resource.data.teacherId == request.auth.uid);
        allow write: if isOwner();
      }
      match /timetableSlots/{slotId} {
        allow read: if isOwner() || (isTeacher() && resource.data.teacherId == request.auth.uid);
        allow write: if isOwner();
      }

      // Sessions (dated instances)
      match /sessions/{sessionId} {
        allow read: if isOwner() || (isTeacher() && resource.data.teacherId == request.auth.uid);
        // Teachers mark and request corrections through the API only
        allow write: if isOwner();
      }

      // Session correction requests
      match /requests/{requestId} {
        allow read: if isOwner() || (isTeacher() && resource.data.teacherId == request.auth.uid);
        allow write: if isOwner();
      }
      match /correctionRequests/{requestId} {
        allow read: if isOwner() || (isTeacher() && resource.data.teacherId == request.auth.uid);
        allow write: if isOwner();
      }

      // Fees: strictly Owner only. Teachers NEVER see fees
      match /fees/{feeId} {
        allow read, write: if isOwner();
      }

      // Salaries: Owner and the specific assigned teacher only
      match /salaries/{salaryId} {
        allow read: if isOwner() || (isTeacher() && resource.data.teacherId == request.auth.uid);
        allow write: if isOwner();
      }

      // Invoices: Owner and the specific assigned teacher only
      match /invoices/{invoiceId} {
        allow read: if isOwner() || (isTeacher() && resource.data.teacherId == request.auth.uid);
        allow write: if isOwner();
      }

      // Audit logs: Owner only
      match /auditLog/{logId} {
        allow read, write: if isOwner();
      }
    }

    // 7. In-app notifications: recipient can read own, owner can read/write all
    match /notifications/{notifId} {
      allow read: if isOwner() || (isAuthenticated() && resource.data.recipientId == request.auth.uid);
      allow write: if isOwner();
    }

    // 8. FCM Push Tokens
    match /fcmTokens/{token} {
      allow read, write: if isOwner();
    }
  }
}
